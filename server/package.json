{
    "name": "evie-server",
    "version": "0.7.13",
    "author": "Jeroen Akkerman",
    "description": "Server module for EVIE",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ionaru/EVIE.git"
    },
    "scripts": {
        "typeorm": "typeorm-ts-node-commonjs",
        "migrate": "typeorm migration:run --dataSource dist/src/data-source.js",
        "migrate:dev": "npm run typeorm -- migration:run --dataSource src/data-source.ts",
        "clean": "rimraf dist",
        "build": "npm run clean && tsc --project tsconfig.json",
        "lint": "eslint --ext ts --max-warnings 0 src",
        "pretest": "npm run lint",
        "test": "echo \"Error: no test specified\" && exit 0",
        "posttest": "tsc --project tsconfig.json --noEmit",
        "start": "npm run migrate && node ./dist/src/index.js",
        "preversion": "npm run test"
    },
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@ionaru/esi-service": "^6.1.0",
        "@ionaru/eve-utils": "^8.0.0",
        "@ionaru/random-string": "^4.0.0",
        "@ionaru/web-server": "^4.0.0",
        "@sentry/node": "^7.120.4",
        "agentkeepalive": "^4.1.3",
        "app-root-path": "^3.0.0",
        "axios": "^1.19.0",
        "body-parser": "^1.20.6",
        "chalk": "^4.1.0",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "debug": "^4.2.0",
        "express": "^4.22.2",
        "express-mysql-session": "^3.0.3",
        "express-session": "^1.19.0",
        "http-status-codes": "^2.1.4",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.23.4",
        "on-finished": "^2.3.0",
        "reflect-metadata": "^0.2.2",
        "socket.io": "^4.8.3",
        "socket.io-express-session": "^0.1.3",
        "source-map-support": "^0.5.19",
        "typeorm": "^0.3.31"
    },
    "overrides": {
        "@ionaru/esi-service": {
            "axios": "1"
        },
        "mysql2": "$mysql2"
    },
    "devDependencies": {
        "@ionaru/eslint-config": "^5.0.1",
        "@types/app-root-path": "^3.1.0",
        "@types/body-parser": "^1.19.0",
        "@types/component-emitter": "^2.0.0",
        "@types/compression": "^1.7.0",
        "@types/cookie": "^1.0.0",
        "@types/cors": "^2.8.8",
        "@types/debug": "^4.1.5",
        "@types/express": "^4.17.9",
        "@types/express-mysql-session": "^3.0.8",
        "@types/express-serve-static-core": "^5.1.3",
        "@types/express-session": "^1.19.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.4.1",
        "@types/on-finished": "^2.3.1",
        "@types/source-map-support": "^0.5.2",
        "@typescript-eslint/eslint-plugin": "^5.4.0",
        "eslint": "^7.13.0",
        "eslint-plugin-import": "^2.24.2",
        "eslint-plugin-jest": "^25.3.0",
        "eslint-plugin-no-null": "^1.0.2",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-sonarjs": "^0.10.0",
        "eslint-plugin-unicorn": "^39.0.0",
        "rimraf": "^6.1.3",
        "ts-node": "^10.2.1",
        "typescript": "^4.0.5"
    },
    "license": "MIT"
}
